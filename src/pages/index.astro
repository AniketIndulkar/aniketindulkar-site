---
import SystemVisual from '../components/SystemVisual.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { liveApps } from '../data/apps';

// Derived from the apps data so the hero badge cannot go stale again.
const liveCount = liveApps.length;

const title = 'Aniket Indulkar — Senior Android Engineer';
const description =
  'Aniket Indulkar is a Senior Android Engineer writing and building around Android performance, mobile architecture and on-device AI.';

const socialLinks = [
  { label: 'Apps', href: '/apps/', external: false },
  { label: 'Writing', href: '/writing/', external: false },
  { label: 'GitHub', href: 'https://github.com/AniketIndulkar', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/aniketindulkar7/', external: true },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://aniketindulkar.dev/#website',
      url: 'https://aniketindulkar.dev/',
      name: 'Aniket Indulkar',
      description,
      inLanguage: 'en-GB',
    },
    {
      '@type': 'Person',
      '@id': 'https://aniketindulkar.dev/#person',
      name: 'Aniket Indulkar',
      url: 'https://aniketindulkar.dev/',
      jobTitle: 'Senior Android Engineer',
      description:
        'Senior Android Engineer building around Android performance, mobile architecture and on-device AI.',
      sameAs: [
        'https://github.com/AniketIndulkar',
        'https://www.linkedin.com/in/aniketindulkar7/',
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main class="landing">
    <div class="landing__ambient" aria-hidden="true"></div>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__content">
        <p class="eyebrow">Aniket Indulkar</p>

        <h1 id="hero-title">
          <span>Building intelligent,</span>
          <span>high-performance</span>
          <span>mobile systems.</span>
        </h1>

        <p class="hero__intro">
          Senior Android Engineer exploring the intersection of mobile performance,
          architecture and on-device AI.
        </p>

        <div class="hero__footer">
          {
            liveCount > 0 && (
              <a class="status status--link" href="/apps/">
                <span class="status__signal" aria-hidden="true" />
                <span>
                  {liveCount} {liveCount === 1 ? 'app' : 'apps'} live on Google Play
                </span>
                <span class="status__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )
          }

          <nav class="social-links" aria-label="External profiles">
            {
              socialLinks.map(({ label, href, external }) => (
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'me noreferrer' : undefined}
                >
                  <span>{label}</span>
                  <span class="social-links__arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
                </a>
              ))
            }
          </nav>
        </div>
      </div>

      <div class="hero__visual">
        <SystemVisual />
      </div>
    </section>
  </main>
</BaseLayout>
