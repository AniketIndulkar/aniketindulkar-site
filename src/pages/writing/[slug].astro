---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);

  return posts.map((post) => {
    const seriesPosts = post.data.series
      ? posts
          .filter(({ data }) => data.series?.id === post.data.series?.id)
          .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0))
          .map((entry) => ({
            id: entry.id,
            title: entry.data.title,
            order: entry.data.series?.order ?? 0,
          }))
      : [];

    return {
      params: { slug: post.id },
      props: { post, seriesPosts },
    };
  });
}

interface Props {
  post: CollectionEntry<'writing'>;
  seriesPosts: Array<{ id: string; title: string; order: number }>;
}

const { post, seriesPosts } = Astro.props;
const { Content, headings } = await render(post);
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  publishedDate={post.data.publishedDate}
  updatedDate={post.data.updatedDate}
  topics={post.data.topics}
  readingTime={getReadingTime(post.body ?? '')}
  headings={headings}
  series={post.data.series}
  seriesPosts={seriesPosts}
  currentPostId={post.id}
>
  <Content />
</ArticleLayout>
