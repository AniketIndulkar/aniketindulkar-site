---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingTime } from '../../utils/readingTime';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
const featuredPosts = posts.filter(({ data }) => data.featured);
const latestPosts = posts.filter(({ data }) => !data.featured);

const title = 'Writing — Aniket Indulkar';
const description =
  'Long-form engineering writing about mobile systems, performance, architecture, on-device AI and the systems behind modern products.';
---

<BaseLayout title={title} description={description}>
  <div class="site-page">
    <SiteHeader />

    <main class="writing-index">
      <header class="writing-index__header">
        <p class="section-eyebrow">Writing</p>
        <h1>Engineering systems,<br />explained from first principles.</h1>
        <p>
          Long-form notes on performance, architecture, intelligent mobile systems and the
          engineering tradeoffs behind production software.
        </p>
      </header>

      {
        featuredPosts.length > 0 && (
          <section class="writing-featured" aria-labelledby="start-here">
            <h2 id="start-here" class="writing-section-title">Start here</h2>
            {featuredPosts.map((post) => (
              <PostCard
                href={`/writing/${post.id}/`}
                title={post.data.title}
                description={post.data.description}
                publishedDate={post.data.publishedDate}
                readingTime={getReadingTime(post.body ?? '')}
                topics={post.data.topics}
                featured
              />
            ))}
          </section>
        )
      }

      <section class="post-list" aria-labelledby="latest-writing">
        <h2 id="latest-writing" class="writing-section-title">Latest writing</h2>
        {
          latestPosts.map((post) => (
            <PostCard
              href={`/writing/${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              publishedDate={post.data.publishedDate}
              readingTime={getReadingTime(post.body ?? '')}
              topics={post.data.topics}
            />
          ))
        }
      </section>

      <p class="writing-index__feed">
        Prefer a feed reader? <a href="/rss.xml">Subscribe via RSS</a>.
      </p>
    </main>
  </div>
</BaseLayout>
