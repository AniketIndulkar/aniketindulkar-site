---
import type { MarkdownHeading } from 'astro';
import SiteHeader from '../components/SiteHeader.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  updatedDate?: Date;
  topics: string[];
  socialImage?: string;
  readingTime: number;
  headings: MarkdownHeading[];
  series?: { id: string; title: string; order: number };
  seriesPosts?: Array<{ id: string; title: string; order: number }>;
  currentPostId?: string;
}

const {
  title,
  description,
  publishedDate,
  updatedDate,
  topics,
  socialImage = '/og.png',
  readingTime,
  headings,
  series,
  seriesPosts = [],
  currentPostId,
} = Astro.props;

const currentSeriesIndex = seriesPosts.findIndex(({ id }) => id === currentPostId);
const previousSeriesPost = currentSeriesIndex > 0 ? seriesPosts[currentSeriesIndex - 1] : undefined;
const nextSeriesPost =
  currentSeriesIndex >= 0 && currentSeriesIndex < seriesPosts.length - 1
    ? seriesPosts[currentSeriesIndex + 1]
    : undefined;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(socialImage, Astro.site);
const authorURL = new URL('/', Astro.site);
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: socialImageURL.href,
  datePublished: publishedDate.toISOString(),
  dateModified: (updatedDate ?? publishedDate).toISOString(),
  inLanguage: 'en-GB',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href,
  },
  author: {
    '@type': 'Person',
    name: 'Aniket Indulkar',
    url: authorURL.href,
    jobTitle: 'Senior Android Engineer',
    sameAs: [
      'https://github.com/AniketIndulkar',
      'https://www.linkedin.com/in/aniketindulkar7/',
    ],
  },
  keywords: topics.join(', '),
};
---

<BaseLayout
  title={`${title} — Aniket Indulkar`}
  description={description}
  pageType="article"
  socialImage={socialImage}
  socialImageAlt={`${title} — Aniket Indulkar`}
  publishedDate={publishedDate}
  updatedDate={updatedDate}
  topics={topics}
  structuredData={articleStructuredData}
>
  <div class="site-page">
    <SiteHeader />

    <main class="article-page">
      <article>
        <header class="article-header">
          <a class="article-header__back" href="/writing/">Writing</a>
          <h1>{title}</h1>
          <p class="article-header__description">{description}</p>

          <div class="article-header__meta">
            <time datetime={publishedDate.toISOString()}>{dateFormatter.format(publishedDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime} min read</span>
            {
              updatedDate && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>Updated {dateFormatter.format(updatedDate)}</span>
                </>
              )
            }
          </div>

          <ul class="topic-list" aria-label="Article topics">
            {topics.map((topic) => <li>{topic}</li>)}
          </ul>

          {
            socialImage !== '/og.png' && (
              <figure class="article-header__cover">
                <img
                  src={socialImage}
                  alt=""
                  width="1200"
                  height="630"
                  loading="eager"
                  decoding="async"
                />
              </figure>
            )
          }
        </header>

        <div class="article-layout">
          <div class="article-main">
            <details class="article-toc-mobile">
              <summary>In this article</summary>
              <TableOfContents headings={headings} label="Article sections" />
            </details>

            <div class="prose">
              <slot />
            </div>

            {
              series && seriesPosts.length > 1 && (
                <nav class="article-series" aria-labelledby="article-series-title">
                  <p class="article-series__eyebrow">Article series</p>
                  <h2 id="article-series-title">{series.title}</h2>
                  <ol>
                    {seriesPosts.map((seriesPost) => (
                      <li class:list={{ 'is-current': seriesPost.id === currentPostId }}>
                        <span class="article-series__step">
                          {seriesPost.order === 0
                            ? 'Overview'
                            : `Week ${String(seriesPost.order).padStart(2, '0')}`}
                        </span>
                        {seriesPost.id === currentPostId ? (
                          <span aria-current="page">{seriesPost.title}</span>
                        ) : (
                          <a href={`/writing/${seriesPost.id}/`}>{seriesPost.title}</a>
                        )}
                      </li>
                    ))}
                  </ol>

                  {(previousSeriesPost || nextSeriesPost) && (
                    <div class="article-series__pager">
                      {previousSeriesPost ? (
                        <a href={`/writing/${previousSeriesPost.id}/`}>
                          <span>Previous</span>
                          {previousSeriesPost.title}
                        </a>
                      ) : (
                        <span />
                      )}
                      {nextSeriesPost && (
                        <a href={`/writing/${nextSeriesPost.id}/`}>
                          <span>Next</span>
                          {nextSeriesPost.title}
                        </a>
                      )}
                    </div>
                  )}
                </nav>
              )
            }

            <footer class="article-footer">
              <p class="article-footer__eyebrow">Written by Aniket Indulkar</p>
              <p>
                Senior Android Engineer exploring mobile performance, architecture and on-device
                AI.
              </p>
              <a href="/writing/">← Back to writing</a>
            </footer>
          </div>

          <aside class="article-sidebar">
            <TableOfContents headings={headings} />
          </aside>
        </div>
      </article>
    </main>
  </div>
</BaseLayout>
